API_KEY=
MODEL=
BASE_URL=
DB_PATH=data/telecom_cs.db
# RAG（阶段 3）：路径与检索参数均可选；中文目录下 Milvus faiss 索引持久化异常时，
# 把 MILVUS_DB_PATH 指向纯英文路径（如 C:/cong_data/milvus_lite.db）
MILVUS_DB_PATH=data/milvus_lite.db
EMBED_MODEL_PATH=models/bge-m3
RERANK_MODEL_PATH=models/bge-reranker
KNOWLEDGE_DIR=knowledge
RAG_RECALL_TOP_K=10
RAG_RERANK_INPUT_TOP_N=8
RAG_RERANK_TOP_K=5
RAG_RERANK_GATE_PROB=0.53
RAG_RERANK_GATE_RAW=0.15
RAG_PREWARM=1
# Skill 热插拔（阶段 4）：外部 Skill 目录 / 目录监听开关 / 轮询间隔秒
SKILLS_EXTRA_DIR=data/skills
SKILL_WATCH=1
SKILL_WATCH_INTERVAL=2
CONG_CONTEXT_TOKEN_LIMIT=400000
CONG_BASH_DEFAULT_TIMEOUT_SECONDS=120
CONG_BASH_MAX_TIMEOUT_SECONDS=600
CONG_BASH_MAX_OUTPUT_CHARS=6000
CONG_BASH_ENV_FILE=
CONG_CHECKPOINT_MODE=light
CONG_TRACE_MODE=on
